# ---------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in the values.
# When you run `supabase start`, the CLI prints the API URL and keys — paste
# them here. The anon key is safe for the browser; the service-role key is
# SERVER-ONLY (used by /admin to create users) and must never be exposed.
# ---------------------------------------------------------------------------

# Supabase API URL. The browser calls this directly (login, uploads), so for
# real devices it MUST be a public HTTPS address, not localhost — e.g. your
# Cloudflare Tunnel hostname for the Supabase API (see README "Running in
# production"). Only use the localhost default when testing on this same PC.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Anon / publishable key (browser-safe)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-local-anon-key

# Service-role key — SERVER ONLY. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-local-service-role-key

# Public site URL (used for redirects / metadata). Set to your tunnel domain
# in production, e.g. https://mars.example.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Seed admin (used by supabase/seed.sql to create the first Head) -------
# Change these before first run, then change the password again after logging
# in. Only referenced by the seed script.
SEED_HEAD_EMAIL=head@marsmeddent.local
SEED_HEAD_PASSWORD=ChangeMe123!
SEED_HEAD_NAME=Ahmed
